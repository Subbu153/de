{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "orders",
						"type": "DatasetReference"
					},
					"name": "orders"
				},
				{
					"dataset": {
						"referenceName": "customers",
						"type": "DatasetReference"
					},
					"name": "customers"
				},
				{
					"dataset": {
						"referenceName": "ordersitems",
						"type": "DatasetReference"
					},
					"name": "ordersitems"
				},
				{
					"dataset": {
						"referenceName": "products",
						"type": "DatasetReference"
					},
					"name": "products"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "result",
						"type": "DatasetReference"
					},
					"name": "result"
				}
			],
			"transformations": [
				{
					"name": "joinwithcustomer"
				},
				{
					"name": "select1"
				},
				{
					"name": "joinwithorderitems"
				},
				{
					"name": "select2"
				},
				{
					"name": "joinwithproducts"
				},
				{
					"name": "select3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          order_id as string,",
				"          customer_id as string,",
				"          order_date as string,",
				"          shipping_city as string,",
				"          order_status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> orders",
				"source(output(",
				"          customer_id as string,",
				"          customer_name as string,",
				"          email as string,",
				"          city as string,",
				"          state as string,",
				"          signup_date as string,",
				"          status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> customers",
				"source(output(",
				"          order_item_id as string,",
				"          order_id as string,",
				"          product_id as string,",
				"          quantity as string,",
				"          unit_price as string,",
				"          total_amount as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> ordersitems",
				"source(output(",
				"          product_id as string,",
				"          product_name as string,",
				"          category as string,",
				"          price as string,",
				"          stock_quantity as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> products",
				"orders, customers join(orders@customer_id == customers@customer_id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinwithcustomer",
				"joinwithcustomer select(mapColumn(",
				"          order_id,",
				"          customer_id = orders@customer_id,",
				"          order_date,",
				"          shipping_city,",
				"          order_status,",
				"          customer_id = customers@customer_id,",
				"          customer_name,",
				"          email,",
				"          city,",
				"          state,",
				"          signup_date,",
				"          status",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1, ordersitems join(select1@order_id == ordersitems@order_id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinwithorderitems",
				"joinwithorderitems select(mapColumn(",
				"          order_id = select1@order_id,",
				"          customer_id,",
				"          order_date,",
				"          shipping_city,",
				"          order_status,",
				"          customer_name,",
				"          email,",
				"          city,",
				"          state,",
				"          signup_date,",
				"          status,",
				"          order_item_id,",
				"          order_id = ordersitems@order_id,",
				"          product_id,",
				"          quantity,",
				"          unit_price,",
				"          total_amount",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2, products join(select2@product_id == products@product_id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinwithproducts",
				"joinwithproducts select(mapColumn(",
				"          order_id,",
				"          customer_id,",
				"          order_date,",
				"          shipping_city,",
				"          order_status,",
				"          customer_name,",
				"          email,",
				"          city,",
				"          state,",
				"          signup_date,",
				"          status,",
				"          order_item_id,",
				"          product_id = select2@product_id,",
				"          quantity,",
				"          unit_price,",
				"          total_amount,",
				"          product_id = products@product_id,",
				"          product_name,",
				"          category,",
				"          price,",
				"          stock_quantity",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          customer_id as string,",
				"          customer_name as string,",
				"          email as string,",
				"          city as string,",
				"          state as string,",
				"          signup_date as string,",
				"          status as string",
				"     ),",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> result"
			]
		}
	}
}