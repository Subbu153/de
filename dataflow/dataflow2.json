{
	"name": "dataflow2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "apiJson",
						"type": "DatasetReference"
					},
					"name": "apidata"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "json_to_csv",
						"type": "DatasetReference"
					},
					"name": "sinkthedatafromapi"
				}
			],
			"transformations": [
				{
					"name": "flatten1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as integer,",
				"          name as string,",
				"          username as string,",
				"          email as string,",
				"          address as (street as string, suite as string, city as string, zipcode as string, geo as (lat as string, lng as string)),",
				"          phone as string,",
				"          website as string,",
				"          company as (name as string, catchPhrase as string, bs as string)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: true,",
				"     documentForm: 'documentPerLine') ~> apidata",
				"apidata foldDown(unroll(),",
				"     mapColumn(",
				"          id,",
				"          name,",
				"          username,",
				"          email,",
				"          phone,",
				"          website,",
				"          street = address.street,",
				"          suite = address.suite,",
				"          city = address.city,",
				"          zipcode = address.zipcode,",
				"          cname = company.name,",
				"          catchPhrase = company.catchPhrase,",
				"          bs = company.bs,",
				"          lat = address.geo.lat,",
				"          lng = address.geo.lng",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> flatten1",
				"flatten1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkthedatafromapi"
			]
		}
	}
}